# PRODUCTION INTELLIGENCE — ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy to .env.local for local development

# Supabase Credentials (Optional for local fallback mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Internal Background Scanner Secret
CRON_SECRET=internal_cron_secret_v1

# Data Mode Override (optional: LIVE_DATA, IN_MEMORY_FALLBACK)
DATA_SOURCE_MODE=IN_MEMORY_FALLBACK
